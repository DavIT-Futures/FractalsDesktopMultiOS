<Window x:Class="sierpinski.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sierpinski"
        mc:Ignorable="d"
        Title="Trójkąt Sierpińskiego - Generator Fraktali C#" 
        Height="720" Width="1100" 
        MinHeight="600" MinWidth="850"
        Background="#121214" Foreground="#E1E1E6"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Dynamic Dark Theme Styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="BorderBrush" Value="#2D2D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="10,12,10,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#C4C4CC"/>
            <Setter Property="Padding" Value="0,4,0,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202024"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#323238"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#29292E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#323238"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323238"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00A3CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Sterowania (Lewa Strona) -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Tytuł Aplikacji -->
                        <TextBlock Text="Trójkąt Sierpińskiego" FontSize="20" FontWeight="Bold" Foreground="#00D4FF" Margin="0,0,0,2"/>
                        <TextBlock Text="Generator Fraktali - C# Desktop" FontSize="12" Foreground="#8D8D99" Margin="0,0,0,16"/>

                        <!-- Grupa: Metoda Generowania -->
                        <GroupBox Header="Algorytm / Metoda">
                            <StackPanel>
                                <Label Content="Wybierz metodę rysowania:"/>
                                <ComboBox x:Name="cmbMethod" SelectionChanged="CmbMethod_SelectionChanged">
                                    <ComboBoxItem Content="Rekurencja (Wypełnione Trójkąty)" IsSelected="True"/>
                                    <ComboBoxItem Content="Rekurencja (Kontury Trójkątów)"/>
                                    <ComboBoxItem Content="Gra Chaosu (Losowe Punktowanie)"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <!-- Grupa: Parametry -->
                        <GroupBox Header="Parametry Algorytmu">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock x:Name="lblParamName" Text="Głębokość rekurencji:" Foreground="#C4C4CC" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtParamValue" Text="6" Width="75" DockPanel.Dock="Right" 
                                             HorizontalContentAlignment="Center" Background="#202024" Foreground="#FFFFFF" 
                                             BorderBrush="#323238" Padding="4" TextChanged="TxtParamValue_TextChanged"/>
                                </DockPanel>
                                <Slider x:Name="sliderParam" Minimum="0" Maximum="9" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="SliderParam_ValueChanged"/>

                                <DockPanel Margin="0,8,0,2">
                                    <TextBlock Text="Grubość / Rozmiar elementu:" Foreground="#C4C4CC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtThicknessValue" Text="1 px" Width="40" TextAlignment="Right" Foreground="#00D4FF" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="sliderThickness" Minimum="1" Maximum="6" Value="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="SliderThickness_ValueChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Grupa: Stylizacja -->
                        <GroupBox Header="Wygląd i Paleta Barw">
                            <StackPanel>
                                <Label Content="Paleta kolorów trójkąta:"/>
                                <ComboBox x:Name="cmbPalette" SelectionChanged="CmbPalette_SelectionChanged">
                                    <ComboBoxItem Content="🌈 Tęcza / Gradient wysokości" IsSelected="True"/>
                                    <ComboBoxItem Content="🩵 Neonowy Cyjan"/>
                                    <ComboBoxItem Content="💛 Złoty / Bursztynowy"/>
                                    <ComboBoxItem Content="💚 Zielony Matrix"/>
                                    <ComboBoxItem Content="💜 Purpurowy Fiolet"/>
                                    <ComboBoxItem Content="🔥 Ogień (Czerwono-Pomarańczowy)"/>
                                </ComboBox>

                                <Label Content="Kolor tła:"/>
                                <ComboBox x:Name="cmbBackground" SelectionChanged="CmbBackground_SelectionChanged">
                                    <ComboBoxItem Content="🖤 Ciemne tło (Czarny/Ciemnoszary)" IsSelected="True"/>
                                    <ComboBoxItem Content="🤍 Jasne tło (Czysta Biel)"/>
                                    <ComboBoxItem Content="🌌 Granat Nocy (Midnight Navy)"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <!-- Przycisk Akcji GO / START -->
                        <Button x:Name="btnStart" Click="BtnStart_Click" Height="46" Margin="0,8,0,8" 
                                Background="#0088CC" BorderBrush="#00D4FF" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶  " FontSize="16"/>
                                <TextBlock Text="START / GO"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnReset" Content="🔄 Wyczyść" Click="BtnReset_Click" Grid.Column="0" Margin="0,0,4,0"/>
                            <Button x:Name="btnSave" Content="💾 Zapisz PNG" Click="BtnSave_Click" Grid.Column="1" Margin="4,0,0,0"/>
                        </Grid>

                        <ProgressBar x:Name="progressBar" Height="6" Margin="0,4,0,4" IsIndeterminate="False" Visibility="Hidden" Foreground="#00D4FF" Background="#202024"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Obszar Rysowania (Prawa Strona) -->
            <Grid Grid.Column="1" Background="#09090A" x:Name="canvasContainer" SizeChanged="CanvasContainer_SizeChanged">
                <Image x:Name="imgCanvas" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Pasek Statusu -->
        <StatusBar Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Foreground="#8D8D99" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Gotowy do generowania. Naciśnij START / GO." Foreground="#00D4FF"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="txtStats" Text="Wymiary: - | Czas: -"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
